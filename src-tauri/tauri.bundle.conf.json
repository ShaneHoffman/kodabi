{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "../target/release/kodabi-mcp.exe": "kodabi-mcp.exe"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
