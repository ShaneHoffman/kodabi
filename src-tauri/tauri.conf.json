{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodabi",
  "version": "0.2.0",
  "identifier": "com.kodabi.app",
  "build": {
    "beforeDevCommand": "pnpm mcp:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm mcp:build:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kodabi",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      },
      {
        "label": "quick-capture",
        "title": "Quick capture",
        "url": "capture.html",
        "width": 640,
        "height": 280,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "capture-overlay",
        "title": "Capture overlay",
        "url": "overlay.html",
        "width": 248,
        "height": 46,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "contentProtected": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/sessions/*.wav"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Shane Hoffman",
    "copyright": "Copyright © 2026 Shane Hoffman",
    "shortDescription": "A self-organizing personal knowledge base.",
    "longDescription": "Kodabi turns meeting transcripts and quick notes into a searchable knowledge base. Recordings are transcribed on your device, distilled into Markdown notes, and routed into your vault automatically.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis/header.bmp",
        "sidebarImage": "icons/nsis/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTRFQzY0OTQ3RThFMDcKUldRSGpuNlVaT3prSWx4Wko5OEJvYlB1Z0IvRFhqVDFUZmYyRlN1b0xGZmtmaEpZNWFVMDFoV0sK",
      "endpoints": [
        "https://github.com/ShaneHoffman/kodabi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
