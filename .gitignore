# Local-only config & secrets — never committed
.kangentic/
.claude/settings.local.json
kangentic.local.json
.env
.env.*

# dependencies
/node_modules

# frontend build output
/dist

# Rust / Cargo — workspace target lives at the repo root (not src-tauri/target)
/target

# STT model files downloaded and cached by CI's app-dev job (and handy locally)
/.ci-models

# Tauri generated capability schemas
/src-tauri/gen/schemas

# TypeScript incremental build cache
/tsconfig.tsbuildinfo

# Real-meeting benchmark fixture: contains actual recorded audio/transcript
# of a real conversation with real participants — kept local-only, never in
# git history (not even a local commit), regardless of push. Only the
# manifest describing the fixture's shape is versioned.
/crates/kodabi-transcribe/tests/data/benchmark/*
!/crates/kodabi-transcribe/tests/data/benchmark/README.md

# OS cruft
.DS_Store
Thumbs.db
